# NeonDB (Postgres) - pooled and direct connection strings
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"
JWT_SECRET="change-me-to-a-long-random-string"
# Nodemailer SMTP (e.g. Gmail app password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS="app-password"
MAIL_FROM="PubSupervise <you@gmail.com>"
# First coordinator (used by npm run db:seed)
SEED_COORDINATOR_EMAIL="coordinator@pub.edu.bd"
SEED_COORDINATOR_PASSWORD="ChangeMe123!"

# Test mode: all faculty emails in the directory are set to this address when seeding (leave empty to use the spreadsheet emails)
FACULTY_DEFAULT_EMAIL="nafi.pubcse@gmail.com"
